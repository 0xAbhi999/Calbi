{
  "name": "calibiai-score",
  "version": "1.0.0",
  "private": true,
  "description": "Calibiai Score — Global Student Assessment & Placement Readiness Platform",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "start:cluster": "pm2 startOrReload ecosystem.config.cjs",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test \"lib/__tests__/**/*.test.ts\"",
    "loadtest": "node scripts/loadtest.js",
    "loadtest:k6": "k6 run scripts/loadtest.k6.js",
    "seed:supabase": "node --experimental-strip-types scripts/seed-supabase.ts",
    "verify:sql": "node scripts/verify-student-report.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.2",
    "next": "^14.2.5",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  }
}
