# ---------------------------------------------------------------------------
# Supabase — get these from your Supabase project: Settings → API
# Leave blank to run the app in fully local demo mode (localStorage + mock AI).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-side only. Settings → API → service_role key. NEVER expose client-side.
#
# NOT required for a student's own writes: every student table is RLS-scoped to
# `auth.uid() = id`, and the API routes forward the signed-in student's access
# token (lib/apiFetch.ts → getClientForRequest), so profile / resume / tracking /
# session / result rows are written as that student.
#
# DO set it for: the admin dashboard (reading every student under RLS),
# `npm run seed:supabase`, and anything that writes before a user token exists.
# Without it an anonymous server write is rejected with
# `42501 new row violates row-level security policy` — the app now surfaces that
# as a banner instead of silently reporting "Saved" (see README → "The student
# saved, but nothing appears in Supabase"; `npm run verify:rls` proves it).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# REQUIRED (not an env var) — Supabase → Authentication → URL Configuration
#
# The app builds its OAuth `redirectTo` dynamically from window.location.origin
# (see app/login/page.tsx), so NOTHING in the code is hard-coded to a domain.
# Supabase, however, only honours a redirectTo that is on its allow list, and
# silently falls back to the Site URL when it is not. Add an entry for EVERY
# origin the app is served from:
#
#   Site URL     : https://assessment.calibiai.com     (production)
#   Redirect URLs: http://localhost:3000/auth/callback (local dev)
#                  https://assessment.calibiai.com/auth/callback
#
# Google Cloud Console does NOT need changing per domain: Supabase is the OAuth
# client, so its Authorized redirect URI stays
# https://<project-ref>.supabase.co/auth/v1/callback for every deployment.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CalibiAI grader (server-side only). Leave the key blank to fall back to the
# built-in rule-based scoring engine. BASE_URL/MODEL target a compatible
# OpenAI-style chat-completions endpoint (defaults apply when left blank).
# ---------------------------------------------------------------------------
CALIBIAI_API_KEY=
CALIBIAI_BASE_URL=
CALIBIAI_MODEL=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) — OPTIONAL
# ---------------------------------------------------------------------------
# Signed admin-session cookie secret. Not required (a local fallback secret is
# used when blank) but you SHOULD set a long random value in production.
# Login credentials are fixed: username `admin`, password `CalibiAdmin@777`.
ADMIN_SECRET=

# Password given to the demo candidates that `npm run seed:supabase` (or the
# "Write candidates into Supabase" button on /admin) creates in Supabase Auth.
# Defaults to CalibiDemo@123 when blank.
SEED_PASSWORD=

# How often the admin dashboard checks for new student data, in milliseconds
# (default 30000). Each tick is a ~1KB change probe — the full dataset is only
# re-downloaded when something changed. Optional — set on the hosting platform,
# not in a checked-in file.
# NEXT_PUBLIC_ADMIN_REFRESH_MS=30000
